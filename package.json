{
  "name": "ordre-des-cendres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "L'Ordre des Cendres : jeu de duel 1 contre 1 en arène, dans le navigateur",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm run dev -w @cendres/client",
    "dev:server": "npm run dev -w @cendres/server",
    "prestart": "node scripts/check-node.mjs",
    "start": "npm run build && npm run start -w @cendres/server",
    "build": "npm run build -w @cendres/client",
    "preview": "npm run preview -w @cendres/client",
    "pretest": "node scripts/check-node.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
